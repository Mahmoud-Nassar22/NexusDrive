pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                // Pull the latest code from GitHub
                checkout scm
            }
        }

        stage('Build') {
    steps {
        dir('simple-nextcloud') {
            sh 'docker compose build'
        }
    }
}

        stage('Deploy') {
    steps {
        dir('simple-nextcloud') {
            sh 'docker compose up -d'
        }
    }
}

        stage('Test') {
            steps {
                // Prove the app actually works: register a user,
                // log in, upload a file, confirm it's listed.
                sh '''
                    sleep 10

                    curl -s -X POST http://localhost:5001/register \
                        -H "Content-Type: application/json" \
                        -d '{"username":"ci-test","password":"ci-test-pass"}'

                    TOKEN=$(curl -s -X POST http://localhost:5001/login \
                        -H "Content-Type: application/json" \
                        -d '{"username":"ci-test","password":"ci-test-pass"}' \
                        | python3 -c "import sys,json; print(json.load(sys.stdin)['token'])")

                    echo "ci test file" > test.txt
                    curl -s -X POST http://localhost:5002/upload \
                        -H "Authorization: Bearer $TOKEN" -F "file=@test.txt"

                    curl -s http://localhost:5002/files \
                        -H "Authorization: Bearer $TOKEN"
                '''
            }
        }
    }

    post {
        success {
            echo 'All 3 services built, deployed, and passed the test.'
        }
        failure {
            echo 'failed failed — check which stage above.'
        }
    }
}