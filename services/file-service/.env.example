# Copy to .env for local development. In Kubernetes these come from ConfigMaps/Secrets.
PORT=3001
LOG_LEVEL=info

# Keycloak realm that issues access tokens
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/nexusdrive
# Optional: expected "aud" claim; leave empty to skip the check
KEYCLOAK_AUDIENCE=
# Optional: Keycloak origin for server-to-server calls inside the cluster
# (e.g. http://keycloak.identity.svc:8080). Empty: use KEYCLOAK_ISSUER_URL's host.
KEYCLOAK_INTERNAL_URL=

# user-service, asked whose files the caller may see (department rules)
USER_SERVICE_URL=http://localhost:3003

# S3 storage. Locally, MinIO on :9000 works as an S3 stand-in.
S3_BUCKET=nexusdrive-files
AWS_REGION=eu-central-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Local MinIO only. On AWS, leave unset: the pod gets credentials from IRSA / Pod Identity.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# How long presigned URLs stay valid, and the max single upload size
PRESIGN_TTL_SECONDS=900
MAX_UPLOAD_BYTES=104857600
