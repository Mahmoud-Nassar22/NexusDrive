# Copy to .env for local development. In Kubernetes these come from ConfigMaps/Secrets.
PORT=3003
LOG_LEVEL=info

# Keycloak realm that issues access tokens (also used to reach the Admin REST API)
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/nexusdrive
KEYCLOAK_AUDIENCE=
# Optional: Keycloak origin for server-to-server calls inside the cluster
# (e.g. http://keycloak.identity.svc:8080). Empty: use KEYCLOAK_ISSUER_URL's host.
KEYCLOAK_INTERNAL_URL=

# Confidential client with a service account (see config/keycloak/nexusdrive-realm.json).
# Its secret must equal NEXUSDRIVE_USER_SERVICE_SECRET given to Keycloak when the realm
# is imported. The value below is the local-dev fallback; in a cluster use a Secret.
KEYCLOAK_ADMIN_CLIENT_ID=nexusdrive-user-service
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-only-user-service-secret

# Postgres for departments and memberships (tables are created on first use)
DATABASE_URL=postgres://nexusdrive:nexusdrive@localhost:5432/nexusdrive
