# Copy to .env for local development. In Kubernetes these come from ConfigMaps/Secrets.
PORT=3002
LOG_LEVEL=info

KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/nexusdrive
KEYCLOAK_AUDIENCE=

# LiveKit. "livekit-server --dev" uses key "devkey" and secret "secret".
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Not used yet. Planned: Postgres for message history, Redis adapter so
# several chat-service replicas share rooms.
DATABASE_URL=
REDIS_URL=
