# Copy to .env for local development. In Kubernetes these come from ConfigMaps/Secrets.
PORT=3002
LOG_LEVEL=info

KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/nexusdrive
KEYCLOAK_AUDIENCE=
# Optional: Keycloak origin for server-to-server calls inside the cluster
# (e.g. http://keycloak.identity.svc:8080). Empty: use KEYCLOAK_ISSUER_URL's host.
KEYCLOAK_INTERNAL_URL=

# LiveKit. "livekit-server --dev" uses key "devkey" and secret "secret".
# LIVEKIT_URL is what the browser connects to (wss:// in production).
LIVEKIT_URL=ws://localhost:7880
# Optional: LiveKit API URL from this service (e.g. http://livekit:7880). Empty: derived from LIVEKIT_URL.
LIVEKIT_API_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Postgres for chat rooms and message history (tables are created on first use)
DATABASE_URL=postgres://nexusdrive:nexusdrive@localhost:5432/nexusdrive

# user-service, asked for the caller's department (who may join which room)
USER_SERVICE_URL=http://localhost:3003

# Optional. socket.io Redis adapter, required to run more than one replica.
# e.g. redis://localhost:6379
REDIS_URL=
